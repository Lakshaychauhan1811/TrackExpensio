# Required for persistent financial data
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB=ai_expense_tracker
GROQ_API_KEY=
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

# Required for stable signed web sessions in production
SESSION_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,https://your-render-domain.onrender.com

# Google OAuth (optional, required for Gmail/Drive login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Plaid (optional; Plaid does not support Indian banks)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US

# Account Aggregator provider credentials (optional; otherwise demo/sandbox behavior)
SETU_API_KEY=
FINVU_API_KEY=
AA_API_KEY=

# Gmail bill reminders (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloud speech transcription (optional)
OPENAI_API_KEY=
